{
  "name": "uistruct",
  "version": "0.5.30",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test strct --watch=false && ng test showcase --watch=false",
    "lint": "ng lint strct && ng lint showcase",
    "lint:fix": "ng lint strct --fix && ng lint showcase --fix",
    "bundle:analyze": "ng build showcase --configuration production --stats-json && npx source-map-explorer dist/showcase/browser/**/*.js",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "ng-packagr": "^22.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
